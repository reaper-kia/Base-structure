{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ML process response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "improved_text": {
      "type": "string",
      "minLength": 1
    },
    "requisites": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "spelling",
              "punctuation",
              "style",
              "structure"
            ]
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "from",
          "to"
        ]
      }
    }
  },
  "required": [
    "improved_text",
    "requisites"
  ]
}