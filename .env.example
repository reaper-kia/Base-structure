# Дальше один раз:          make pull-model
# Ничего больше редактировать не нужно - значения ниже рабочие.
 
# ---------- Приложение ----------
APP_NAME=hackathon
APP_ENV=local
APP_DEBUG=true
 
# ---------- PostgreSQL ----------
# POSTGRES_PASSWORD и пароль внутри DATABASE_URL должны совпадать.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=hackathon
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
DATABASE_URL=postgresql+asyncpg://hackathon:hackathon@db:5432/hackathon
 
# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=hackathon
 
# Кэш результатов ИИ по хэшу черновика (TL-04): 10 минут.
CACHE_TTL_SECONDS=600
 
# ---------- ML-сервис ----------
# Пустая строка = ИИ выключен, бэкенд обязан пережить это (сценарий 6).
ML_SERVICE_URL=http://ml_service:8100
# 90 секунд: 7B на CPU думает до минуты. Меньше ставить нельзя.
ML_REQUEST_TIMEOUT_SECONDS=90
# Тумблер отказа ИИ для демонстрации (TL-06). В рантайме дёргается
# через POST /api/dev/break-ai, тут - начальное значение.
AI_FORCE_FAILURE=false
 
# ---------- Шаблоны DOCX ----------
TEMPLATES_DIR=src/modules/templates/assets
DEFAULT_TEMPLATE_ID=classic
 
# ---------- Kafka ----------
# Нужны только при запуске с профилем events: docker compose --profile events up
KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_CLIENT_ID=hackathon
KAFKA_EVENTS_CONSUMER_GROUP=hackathon.events
KAFKA_EVENTS_TOPIC=hackathon.events.v1
KAFKA_EVENTS_DLQ_TOPIC=hackathon.events.dlq.v1
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_DELAY_SECONDS=1.0
OUTBOX_PUBLISHER_BATCH_SIZE=100
OUTBOX_PUBLISHER_POLL_INTERVAL_SECONDS=1.0
 
