# Скопируй в .env и запусти: docker compose up -d --build
# Затем один раз:            make pull-model
# Значения ниже рабочие, менять обязательно только ORG_NAME.

# ---------- Приложение ----------
APP_NAME=doc3
APP_ENV=local
APP_DEBUG=true

# Название организации в верхнем колонтитуле шаблона «Классический
# корпоративный» (требование организаторов к оформлению).
# Если оставить значение по умолчанию, в документе останется явная
# пометка незаполненного поля — выдумывать название сервис не будет.
ORG_NAME=[Название организации]

# ---------- PostgreSQL ----------
# POSTGRES_PASSWORD и пароль внутри DATABASE_URL должны совпадать.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=hackathon_geo
POSTGRES_USER=hackathon_geo
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql+asyncpg://hackathon_geo:replace-with-a-database-password@db:5432/hackathon_geo

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=doc3

# Кэш результатов ИИ по хэшу черновика: повторная обработка того же текста
# не тратит минуту на модель.
CACHE_TTL_SECONDS=600
FALLBACK_CACHE_TTL_SECONDS=30
# Входит в ключ кэша: правка промпта инвалидирует старые ответы.
PROMPT_VERSION=1.1.0

# Максимальное время обработки одного документа: если фоновая задача
# зависла (например, процесс бэкенда перезапустился посреди обработки),
# документ не должен вечно висеть в "processing" — по истечении дедлайна
# первый же GET сам пометит его failed (dependencies.check_deadline).
# Держим с запасом НАД ML_REQUEST_TIMEOUT_SECONDS ниже, иначе дедлайн
# сработает раньше, чем ml_service успеет честно ответить или откатиться
# на резерв.
PROCESSING_DEADLINE_SECONDS=240

# ---------- ML-сервис ----------
# Пустая строка = ИИ выключен. Бэкенд обязан это пережить (сценарий 6).
ML_SERVICE_URL=http://ml_service:8100
# Таймаут запроса бэкенда К ml_service — это НЕ то же самое, что таймаут
# ml_service на вызов Ollama (ml_service/.env: OLLAMA_TIMEOUT_SECONDS=90).
# Внутри одного запроса ml_service может дважды сходить в Ollama (основной
# проход + repair, если ответ модели не разобрался как JSON) — то есть
# честный воркер имеет право работать до ~2×OLLAMA_TIMEOUT_SECONDS. Если
# поставить здесь 90, бэкенд оборвёт соединение и запишет "failed" раньше,
# чем ml_service успеет откатиться на резервную обработку — документ
# провалится там, где должен был просто получить резервный текст.
# Держим заметно больше 2×90 и меньше PROCESSING_DEADLINE_SECONDS.
ML_REQUEST_TIMEOUT_SECONDS=220
# Тумблер имитации отказа ИИ для демонстрации сценария 6.
# В рантайме переключается через POST /api/dev/break-ai.
AI_FORCE_FAILURE=false

# ---------- Шаблоны DOCX ----------
TEMPLATES_DIR=src/modules/templates/assets
# Куда складываются шаблоны, загруженные пользователем.
# В бою это отдельный том: образ примонтирован только на чтение.
USER_TEMPLATES_DIR=data/templates
DEFAULT_TEMPLATE_ID=classic

# Секрет для POST /api/templates/upload. Сгенерируйте отдельное значение:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пустое значение оставляет загрузку закрытой.
ADMIN_TOKEN=replace-with-a-long-random-secret
