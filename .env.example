# Application
APP_NAME=hackathon
APP_ENV=local
APP_DEBUG=true

# Authentication
# Сгенерируй значения, например:
# python -c "import secrets; print(secrets.token_urlsafe(64))"




POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=hackathon
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql+asyncpg://hackathon:replace-with-a-database-password@db:5432/hackathon


REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=hackathon


CACHE_TTL_SECONDS=60


# Нужны только при запуске с профилем events
KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_CLIENT_ID=hackathon
KAFKA_EVENTS_CONSUMER_GROUP=hackathon.events
KAFKA_EVENTS_TOPIC=hackathon.events.v1
KAFKA_EVENTS_DLQ_TOPIC=hackathon.events.dlq.v1
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_DELAY_SECONDS=1.0

OUTBOX_PUBLISHER_BATCH_SIZE=100
OUTBOX_PUBLISHER_POLL_INTERVAL_SECONDS=1.0


# ML-сервис. Пустая строка = ML выключен, приложение работает без него.
ML_SERVICE_URL=http://ml_service:8100
ML_REQUEST_TIMEOUT_SECONDS=3.0

ML_SERVICE_URL=http://ml_service:8100
ML_REQUEST_TIMEOUT_SECONDS=90
AI_FORCE_FAILURE=false
