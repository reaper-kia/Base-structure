APP_NAME=ML Service
APP_DEBUG=false

# Ollama. В docker-сети адрес — имя сервиса, а не localhost.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# 7B на CPU думает до минуты, меньше ставить нельзя.
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_TEMPERATURE=0.2

# Сколько раз повторяем вызов модели при невалидном ответе.
MAX_ATTEMPTS=2
# Второй вызов модели «почини этот JSON».
REPAIR_ENABLED=true

# false = вместо резервной обработки отдавать 503. На демо всегда true.
FALLBACK_ENABLED=true

HOST=0.0.0.0
PORT=8100
