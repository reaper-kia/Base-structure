APP_NAME=ML Service
APP_DEBUG=false

# Ollama. В docker-сети адрес — имя сервиса, а не localhost.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# 7B на CPU думает до минуты, меньше ставить нельзя.
OLLAMA_TIMEOUT_SECONDS=220
OLLAMA_TEMPERATURE=0.2

# Справочные материалы для официально-деловой терминологии и стиля.
# Если bge-m3 недоступна, сервис продолжит работу с lexical retrieval.
RAG_ENABLED=true
RAG_VECTOR_ENABLED=true
RAG_EMBED_MODEL=bge-m3
RAG_EMBED_TIMEOUT_SECONDS=15
# Не держим embedding-модель в памяти рядом с основной 7B-моделью.
RAG_EMBED_KEEP_ALIVE=0
RAG_TOP_K=3
RAG_MIN_SCORE=0.2
RAG_MAX_CONTEXT_CHARS=3000
RAG_KNOWLEDGE_DIR=knowledge

# Сколько раз повторяем вызов модели при невалидном ответе.
MAX_ATTEMPTS=2
# Второй вызов модели «почини этот JSON».
REPAIR_ENABLED=true

# false = вместо резервной обработки отдавать 503. На демо всегда true.
FALLBACK_ENABLED=true

HOST=0.0.0.0
PORT=8100
