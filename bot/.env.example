MAX_BOT_TOKEN=replace-with-token
API_BASE_URL=http://app:8000

# Optional reliability tuning (defaults shown).
MAX_LONG_POLL_TIMEOUT_SECONDS=30
API_REQUEST_TIMEOUT_SECONDS=15
DOCUMENT_POLL_INTERVAL_SECONDS=1.5
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=120
HTTP_MAX_ATTEMPTS=4
HTTP_RETRY_BACKOFF_SECONDS=0.5
MAX_ATTACHMENT_READY_ATTEMPTS=6
MAX_CONCURRENT_JOBS=8
MAX_SKIP_PENDING_UPDATES=true
LOG_LEVEL=INFO
